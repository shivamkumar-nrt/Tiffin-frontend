# --- Database: SQLite via Turso (hosted SQLite) ---
# Production / Vercel: Turso database URL + token (turso.tech -> your database -> Create Token)
TURSO_DATABASE_URL="libsql://YOUR-DB-NAME-YOUR-ORG.aws-ap-south-1.turso.io"
TURSO_AUTH_TOKEN="paste-token-here"

# Local development / scripts: a plain SQLite file (path is relative to the prisma/ folder).
# `npm run db:push` creates the tables in it. Leave TURSO_* unset locally to use this file.
DATABASE_URL="file:./dev.db"

# --- Auth ---
# Any long random string, e.g. `openssl rand -base64 48`
JWT_SECRET="change-me"
# Token lifetime in ms (default 24h)
JWT_EXPIRATION_MS=86400000

# --- Business defaults ---
DEFAULT_FULL_PRICE=120.00
DEFAULT_HALF_PRICE=80.00
# Timezone used for "today" and reminder windows
APP_TIMEZONE="Asia/Kolkata"
# Shown in payment reminder emails
PAYEE_NAME="Shivam Kumar"
PAYEE_UPI_ID="shivamstm01@kotak"

# --- Seed admin (used by `npm run db:seed`, only when users table is empty) ---
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me"
ADMIN_NAME="Admin"
ADMIN_PHONE=""

# --- Email (optional; without it emails are only logged) ---
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USERNAME=""
SMTP_PASSWORD=""

# --- WhatsApp auto-dispatch (optional) ---
WHATSAPP_API_ENABLED=true
WHATSAPP_API_PROVIDER="generic"   # meta | ultramsg | generic
WHATSAPP_API_URL=""
WHATSAPP_API_TOKEN=""
WHATSAPP_INSTANCE_ID=""
WHATSAPP_PHONE_NUMBER_ID=""

# --- Scheduled reminders (Vercel Cron sends this as Bearer token) ---
CRON_SECRET=""

# --- Frontend ---
# Leave unset to call the built-in /api routes on the same origin
# NEXT_PUBLIC_API_URL="/api"
