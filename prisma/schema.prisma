generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum RoleType {
  ROLE_ADMIN
  ROLE_EMPLOYEE
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum TiffinType {
  FULL
  HALF
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum RecordStatus {
  UNPAID
  BILLED_PAID
}

enum PaymentStatus {
  PENDING_VERIFICATION
  SUCCESS
  FAILED
}

enum PaymentMethod {
  CASH
  UPI
  BANK_TRANSFER
  CREDIT_CARD
  OTHER
}

enum ItemCategory {
  MAIN_COURSE
  CURRY
  BREAD
  RICE
  DESSERT
  SALAD
  BEVERAGE
  SPECIAL
}

model User {
  id         Int        @id @default(autoincrement())
  email      String     @unique @db.VarChar(100)
  password   String
  fullName   String     @db.VarChar(100)
  phone      String?    @db.VarChar(20)
  department String?    @db.VarChar(100)
  role       RoleType
  status     UserStatus @default(ACTIVE)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  requests TiffinRequest[]
  records  TiffinRecord[]
  payments Payment[]
  invoices Invoice[]

  @@index([status])
  @@index([role])
  @@map("users")
}

model PriceConfig {
  id            Int        @id @default(autoincrement())
  tiffinType    TiffinType
  price         Decimal    @db.Decimal(10, 2)
  effectiveFrom DateTime   @db.Date
  effectiveTo   DateTime?  @db.Date
  isActive      Boolean    @default(true)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([tiffinType, isActive])
  @@map("price_configs")
}

model ComboPackage {
  id            Int        @id @default(autoincrement())
  name          String     @db.VarChar(100)
  tiffinType    TiffinType @default(FULL)
  price         Decimal    @db.Decimal(10, 2)
  description   String?    @db.VarChar(500)
  includedItems String[]
  isActive      Boolean    @default(true)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([isActive])
  @@map("combo_packages")
}

model Menu {
  id          Int        @id @default(autoincrement())
  serviceDate DateTime   @unique @db.Date
  title       String     @db.VarChar(150)
  description String?    @db.VarChar(500)
  isSpecial   Boolean    @default(false)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  items       MenuItem[]

  @@map("menus")
}

// Dishes catalog rows have menuId = null; rows attached to a menu are that day's dishes.
model MenuItem {
  id          Int          @id @default(autoincrement())
  menuId      Int?
  menu        Menu?        @relation(fields: [menuId], references: [id], onDelete: Cascade)
  name        String       @db.VarChar(100)
  category    ItemCategory
  description String?      @db.VarChar(255)
  isSpicy     Boolean      @default(false)
  isSweet     Boolean      @default(false)
  isAvailable Boolean      @default(true)

  @@index([menuId])
  @@map("menu_items")
}

model TiffinRequest {
  id                  Int           @id @default(autoincrement())
  userId              Int
  user                User          @relation(fields: [userId], references: [id])
  serviceDate         DateTime      @db.Date
  tiffinType          TiffinType
  specialInstructions String?       @db.VarChar(500)
  status              RequestStatus @default(PENDING)
  reviewedBy          String?       @db.VarChar(100)
  rejectionReason     String?       @db.VarChar(500)
  reviewedAt          DateTime?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  record              TiffinRecord?

  @@index([userId, serviceDate])
  @@index([status])
  @@index([serviceDate])
  @@map("tiffin_requests")
}

model TiffinRecord {
  id             Int           @id @default(autoincrement())
  requestId      Int           @unique
  request        TiffinRequest @relation(fields: [requestId], references: [id])
  userId         Int
  user           User          @relation(fields: [userId], references: [id])
  serviceDate    DateTime      @db.Date
  tiffinType     TiffinType
  menuSnapshot   String?       @db.VarChar(1000)
  chargedAmount  Decimal       @db.Decimal(10, 2)
  status         RecordStatus  @default(UNPAID)
  paymentId      Int?
  payment        Payment?      @relation(fields: [paymentId], references: [id])
  createdAt      DateTime      @default(now())
  invoiceItem    InvoiceItem?

  @@index([userId, serviceDate])
  @@index([status])
  @@index([serviceDate])
  @@map("tiffin_records")
}

model Payment {
  id              Int           @id @default(autoincrement())
  paymentNumber   String        @unique @db.VarChar(50)
  userId          Int
  user            User          @relation(fields: [userId], references: [id])
  amount          Decimal       @db.Decimal(10, 2)
  paymentMethod   PaymentMethod
  transactionRef  String?       @db.VarChar(100)
  paymentDate     DateTime?     @db.Date
  paymentApp      String?       @db.VarChar(100)
  notes           String?       @db.VarChar(500)
  rejectionReason String?       @db.VarChar(500)
  status          PaymentStatus @default(PENDING_VERIFICATION)
  verifiedBy      String?       @db.VarChar(100)
  verifiedAt      DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  records         TiffinRecord[]
  invoice         Invoice?

  @@index([userId])
  @@index([status])
  @@map("payments")
}

model Invoice {
  id               Int           @id @default(autoincrement())
  invoiceNumber    String        @unique @db.VarChar(50)
  userId           Int
  user             User          @relation(fields: [userId], references: [id])
  paymentId        Int?          @unique
  payment          Payment?      @relation(fields: [paymentId], references: [id])
  billingStartDate DateTime      @db.Date
  billingEndDate   DateTime      @db.Date
  totalAmount      Decimal       @db.Decimal(10, 2)
  paymentAmount    Decimal       @db.Decimal(10, 2)
  paymentStatus    PaymentStatus @default(SUCCESS)
  notes            String?       @db.VarChar(500)
  generatedBy      String?       @db.VarChar(100)
  generatedAt      DateTime      @default(now())
  items            InvoiceItem[]

  @@index([userId])
  @@map("invoices")
}

model InvoiceItem {
  id             Int          @id @default(autoincrement())
  invoiceId      Int
  invoice        Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  tiffinRecordId Int          @unique
  tiffinRecord   TiffinRecord @relation(fields: [tiffinRecordId], references: [id])
  serviceDate    DateTime     @db.Date
  tiffinType     TiffinType
  menuSummary    String?      @db.VarChar(500)
  chargedAmount  Decimal      @db.Decimal(10, 2)

  @@index([invoiceId])
  @@map("invoice_items")
}

model AuditLog {
  id          Int      @id @default(autoincrement())
  action      String   @db.VarChar(50)
  entityName  String   @db.VarChar(50)
  entityId    String?  @db.VarChar(50)
  performedBy String   @db.VarChar(100)
  details     String?  @db.VarChar(1000)
  timestamp   DateTime @default(now())

  @@index([action])
  @@index([timestamp])
  @@map("audit_logs")
}

model BroadcastNotification {
  id              Int      @id @default(autoincrement())
  title           String   @db.VarChar(200)
  message         String   @db.VarChar(2000)
  targetAudience  String   @db.VarChar(50)
  targetUserId    Int?
  targetUserName  String?  @db.VarChar(100)
  channels        String?  @db.VarChar(100)
  sentBy          String?  @db.VarChar(100)
  recipientsCount Int      @default(0)
  createdAt       DateTime @default(now())

  @@index([createdAt])
  @@map("broadcast_notifications")
}
