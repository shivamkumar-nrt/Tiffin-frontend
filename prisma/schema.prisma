generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id         Int        @id @default(autoincrement())
  email      String     @unique
  password   String
  fullName   String
  phone      String?
  department String?
  role       String
  status     String @default("ACTIVE")
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  requests TiffinRequest[]
  records  TiffinRecord[]
  payments Payment[]
  invoices Invoice[]

  @@index([status])
  @@index([role])
  @@map("users")
}

model PriceConfig {
  id            Int        @id @default(autoincrement())
  tiffinType    String
  price         Decimal
  effectiveFrom DateTime
  effectiveTo   DateTime?
  isActive      Boolean    @default(true)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([tiffinType, isActive])
  @@map("price_configs")
}

model ComboPackage {
  id            Int        @id @default(autoincrement())
  name          String
  tiffinType    String @default("FULL")
  price         Decimal
  description   String?
  includedItems String   @default("[]")
  isActive      Boolean    @default(true)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([isActive])
  @@map("combo_packages")
}

model Menu {
  id          Int        @id @default(autoincrement())
  serviceDate DateTime   @unique
  title       String
  description String?
  isSpecial   Boolean    @default(false)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  items       MenuItem[]

  @@map("menus")
}

// Dishes catalog rows have menuId = null; rows attached to a menu are that day's dishes.
model MenuItem {
  id          Int          @id @default(autoincrement())
  menuId      Int?
  menu        Menu?        @relation(fields: [menuId], references: [id], onDelete: Cascade)
  name        String
  category    String
  description String?
  isSpicy     Boolean      @default(false)
  isSweet     Boolean      @default(false)
  isAvailable Boolean      @default(true)

  @@index([menuId])
  @@map("menu_items")
}

model TiffinRequest {
  id                  Int           @id @default(autoincrement())
  userId              Int
  user                User          @relation(fields: [userId], references: [id])
  serviceDate         DateTime
  tiffinType          String
  specialInstructions String?
  status              String @default("PENDING")
  reviewedBy          String?
  rejectionReason     String?
  reviewedAt          DateTime?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  record              TiffinRecord?

  @@index([userId, serviceDate])
  @@index([status])
  @@index([serviceDate])
  @@map("tiffin_requests")
}

model TiffinRecord {
  id             Int           @id @default(autoincrement())
  requestId      Int           @unique
  request        TiffinRequest @relation(fields: [requestId], references: [id])
  userId         Int
  user           User          @relation(fields: [userId], references: [id])
  serviceDate    DateTime
  tiffinType     String
  menuSnapshot   String?
  chargedAmount  Decimal
  status         String  @default("UNPAID")
  paymentId      Int?
  payment        Payment?      @relation(fields: [paymentId], references: [id])
  createdAt      DateTime      @default(now())
  invoiceItem    InvoiceItem?

  @@index([userId, serviceDate])
  @@index([status])
  @@index([serviceDate])
  @@map("tiffin_records")
}

model Payment {
  id              Int           @id @default(autoincrement())
  paymentNumber   String        @unique
  userId          Int
  user            User          @relation(fields: [userId], references: [id])
  amount          Decimal
  paymentMethod   String
  transactionRef  String?
  paymentDate     DateTime?
  paymentApp      String?
  notes           String?
  rejectionReason String?
  status          String @default("PENDING_VERIFICATION")
  verifiedBy      String?
  verifiedAt      DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  records         TiffinRecord[]
  invoice         Invoice?

  @@index([userId])
  @@index([status])
  @@map("payments")
}

model Invoice {
  id               Int           @id @default(autoincrement())
  invoiceNumber    String        @unique
  userId           Int
  user             User          @relation(fields: [userId], references: [id])
  paymentId        Int?          @unique
  payment          Payment?      @relation(fields: [paymentId], references: [id])
  billingStartDate DateTime
  billingEndDate   DateTime
  totalAmount      Decimal
  paymentAmount    Decimal
  paymentStatus    String @default("SUCCESS")
  notes            String?
  generatedBy      String?
  generatedAt      DateTime      @default(now())
  items            InvoiceItem[]

  @@index([userId])
  @@map("invoices")
}

model InvoiceItem {
  id             Int          @id @default(autoincrement())
  invoiceId      Int
  invoice        Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  tiffinRecordId Int          @unique
  tiffinRecord   TiffinRecord @relation(fields: [tiffinRecordId], references: [id])
  serviceDate    DateTime
  tiffinType     String
  menuSummary    String?
  chargedAmount  Decimal

  @@index([invoiceId])
  @@map("invoice_items")
}

model AuditLog {
  id          Int      @id @default(autoincrement())
  action      String
  entityName  String
  entityId    String?
  performedBy String
  details     String?
  timestamp   DateTime @default(now())

  @@index([action])
  @@index([timestamp])
  @@map("audit_logs")
}

model BroadcastNotification {
  id              Int      @id @default(autoincrement())
  title           String
  message         String
  targetAudience  String
  targetUserId    Int?
  targetUserName  String?
  channels        String?
  sentBy          String?
  recipientsCount Int      @default(0)
  createdAt       DateTime @default(now())

  @@index([createdAt])
  @@map("broadcast_notifications")
}
